+def stage_layout(num_tasks: int) -> tuple[tuple[int, ...], tuple[int, ...], int]:
+    """Per-model stage tables for the first ``num_tasks`` tasks.
+
+    Returns (task_num_stages, task_stage_offsets, total_task_stage_embeddings). Because the tables are
+    prefixes of TASK_NUM_STAGES, a 50-task model's layout (596 embeddings, original offsets) is exactly
+    the prefix of a 100-task model's layout -- which is what lets the 2025 winner's task_stage_embeddings
+    be copied row-for-row into the extended table.
+    """
+    if not 0 < num_tasks <= len(TASK_NUM_STAGES):
+        raise ValueError(f"num_tasks must be in 1..{len(TASK_NUM_STAGES)}, got {num_tasks}")
+    stages = tuple(TASK_NUM_STAGES[:num_tasks])
+    offsets = tuple([0] + [sum(stages[: i + 1]) for i in range(len(stages) - 1)])
+    return stages, offsets, sum(stages)
+
+
+# Backwards-compatible module constants for the original 50-task model.
+_, TASK_STAGE_OFFSETS, TOTAL_TASK_STAGE_EMBEDDINGS = stage_layout(NUM_TASKS_2025)  # 596 total embeddings
 
 
