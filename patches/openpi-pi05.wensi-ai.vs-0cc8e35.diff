diff --git a/src/openpi/training/task89_dataset.py b/src/openpi/training/task89_dataset.py
new file mode 100644
index 0000000..98d6935
--- /dev/null
+++ b/src/openpi/training/task89_dataset.py
@@ -0,0 +1,47 @@
+"""Read a downloaded task subset using its original global episode IDs."""
+from pathlib import Path
+import lerobot.datasets.dataset_metadata as metadata
+
+class EpisodeIndexView:
+    def __init__(self, dataset):
+        self.dataset = dataset
+        self.by_id = {int(row['episode_index']): row for row in dataset}
+    def __getitem__(self, key):
+        if isinstance(key, int):
+            if key < 0:
+                return self.dataset[key]
+            # Fall back to positional lookup for datasets that aren't keyed by
+            # original global episode IDs (e.g. a standalone single-task dataset
+            # renumbered from 0) -- by_id is only required for task89-style
+            # subsets pulled out of a larger combined dataset.
+            return self.by_id[key] if key in self.by_id else self.dataset[key]
+        return self.dataset[key]
+    def __len__(self):
+        return len(self.dataset)
+    def __iter__(self):
+        return iter(self.dataset)
+    def __getattr__(self, key):
+        if key in ('dataset', 'by_id'):
+            raise AttributeError(key)
+        return getattr(self.dataset, key)
+
+_original_load = metadata.load_episodes
+
+def load_episodes(root):
+    return EpisodeIndexView(_original_load(root))
+
+def data_path(self, ep_index):
+    if self.episodes is None:
+        self.episodes = load_episodes(self.root)
+    ep = self.episodes[ep_index]
+    return Path(self.data_path.format(chunk_index=ep['data/chunk_index'], file_index=ep['data/file_index']))
+
+def video_path(self, ep_index, vid_key):
+    if self.episodes is None:
+        self.episodes = load_episodes(self.root)
+    ep = self.episodes[ep_index]
+    return Path(self.video_path.format(video_key=vid_key, chunk_index=ep[f'videos/{vid_key}/chunk_index'], file_index=ep[f'videos/{vid_key}/file_index']))
+
+metadata.load_episodes = load_episodes
+metadata.LeRobotDatasetMetadata.get_data_file_path = data_path
+metadata.LeRobotDatasetMetadata.get_video_file_path = video_path
